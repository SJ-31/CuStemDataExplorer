Bootstrap: docker
From: rocker/verse:4.6.0
# Run golem::add_dockerfile_with_renv(open = FALSE, output_dir = "deploy") first
# to get the app tarball

# Make sure to run with --no-home to stop user R profile from
# polluting the inner R

%files
    StemDataExplorer_*.tar.gz /opt/app.tar.gz    
    renv.lock.prod renv.lock
    
%environment
    export R_LIBS_USER=/usr/local/lib/R/site-library
    export R_LIBS_SITE=/usr/local/lib/R/site-library
    export R_LIBS=/usr/local/lib/R/site-library
    export R_PROFILE_USER=/dev/null
    export R_ENVIRON_USER=/dev/null
    
%post
    apt-get update -y && apt-get install -y libreadline-dev libcurl4-openssl-dev libicu-dev libssl-dev libpng-dev python3 cmake make libuv1-dev pandoc libx11-dev zlib1g-dev libxml2-dev git && rm -rf /var/lib/apt/lists/*
    mkdir -p /usr/local/lib/R/etc/ /usr/lib/R/etc/ /tmp/renv_singularity
    Rscript -e 'install.packages("rlang")'
    Rscript -e 'install.packages("renv")'
    Rscript -e 'install.packages("remotes")'
    export RENV_PATHS_CACHE="/tmp/renv_singularity"
    # Must bind this path in call to "apptainer build"
    echo "options(renv.config.pak.enabled = FALSE, repos = c(CRAN = 'https://cran.rstudio.com/'), download.file.method = 'libcurl', Ncpus = 4)" | tee /usr/local/lib/R/etc/Rprofile.site | tee /usr/lib/R/etc/Rprofile.site
    export RENV_CONFIG_CACHE_SYMLINKS=FALSE
    Rscript -e "renv::restore()"
    Rscript -e 'remotes::install_local("/opt/app.tar.gz",upgrade="never")'
    rm /opt/app.tar.gz
    
%startscript
    R -e "options('shiny.port'=80,shiny.host='0.0.0.0');library(StemDataExplorer);StemDataExplorer::run_app()"
