Bootstrap: docker
From: rocker/verse:4.6.0


%files
    StemDataExplorer_*.tar.gz /opt/app.tar.gz    
    renv.lock.prod renv.lock
    
%post
    R -e 'install.packages("renv")'
    R -e 'install.packages("remotes")'
    apt-get update -y && apt-get install -y libreadline-dev libcurl4-openssl-dev libicu-dev libssl-dev libpng-dev python3 cmake make libuv1-dev pandoc libx11-dev zlib1g-dev libxml2-dev git && rm -rf /var/lib/apt/lists/*
    export RENV_PATHS_CACHE="~/.cache/R/renv"
    mkdir -p /usr/local/lib/R/etc/ /usr/lib/R/etc/
    echo "options(renv.config.pak.enabled = FALSE, repos = c(CRAN = 'https://cran.rstudio.com/'), download.file.method = 'libcurl', Ncpus = 4)" | tee /usr/local/lib/R/etc/Rprofile.site | tee /usr/lib/R/etc/Rprofile.site
    export RENV_CONFIG_CACHE_SYMLINKS=FALSE
    R -e "renv::restore()"
    R -e 'remotes::install_local("/opt/app.tar.gz",upgrade="never")'
    rm /opt/app.tar.gz
    
%startscript
    R -e "options('shiny.port'=80,shiny.host='0.0.0.0');library(StemDataExplorer);StemDataExplorer::run_app()"
